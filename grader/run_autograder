#!/usr/bin/env bash

set -euo pipefail

# 0. Activate the Python 3.13 virtual environment created in setup.sh
source /autograder/venv/bin/activate

# 1. Initialize the repo and checkout ONLY the mapping file first
git clone --no-checkout --depth 1 --sparse git@github.com:Purdue-FYE/13100_content /autograder/13100_content
cd /autograder/13100_content

# Pull down the mapping file from grader/
git sparse-checkout set "grader/assignment_mapping.json"
git checkout main

# 2. Extract the assignment title from Gradescope's metadata
export ASSIGNMENT_TITLE=$(python3 -c "import sys, json; print(json.load(open('/autograder/submission_metadata.json'))['assignment']['title'])")

echo "Bootstrapping environment for: $ASSIGNMENT_TITLE"

# 3. Safely parse the mapping file to find the target repository path
export TARGET_DIR=$(python3 -c '
import json, os
title = os.environ.get("ASSIGNMENT_TITLE")
try:
    with open("grader/assignment_mapping.json") as f:
        mapping = json.load(f)
    print(mapping[title])
except (KeyError, FileNotFoundError):
    print("NOT_FOUND")
')

if [ "$TARGET_DIR" == "NOT_FOUND" ]; then
    echo "Error: No mapping found in grader/assignment_mapping.json for assignment title: '$ASSIGNMENT_TITLE'"
    exit 1
fi

echo "Mapping successful. Target directory: $TARGET_DIR"

# 4. Expand sparse checkout to include assignment source, grader files, and the
# build script used to generate the runtime artifact layout.
git sparse-checkout add "$TARGET_DIR" "grader" "source/generate_graders.py"

# Update the working tree with the newly requested folders
git checkout main

# 5. Build the grader artifact layout for the selected assignment so tests have
# generated reference modules in tests/. We avoid source/_build so this works
# independently of any .gitignore patterns.
export BUILD_DIR="${TARGET_DIR/source\//source/.grader_runtime/}"
python3 source/generate_graders.py "$BUILD_DIR"

# Locate the extracted grader runtime directory created by generate_graders.py.
RUNTIME_DIR=$(python3 -c '
from pathlib import Path
import os

build_dir = Path(os.environ["BUILD_DIR"])
candidates = [
    p for p in build_dir.glob("autograder_*")
    if p.is_dir()
]
if not candidates:
    raise SystemExit("NOT_FOUND")

latest = sorted(candidates, key=lambda p: p.stat().st_mtime)[-1]
print(latest.as_posix())
')

if [ "$RUNTIME_DIR" == "NOT_FOUND" ]; then
    echo "Error: Could not locate generated grader runtime directory under $BUILD_DIR"
    exit 1
fi

# 6. Copy runtime grader files and shared grader scripts into /autograder/source.
cp -a /autograder/13100_content/$RUNTIME_DIR/. /autograder/source/
cp -a /autograder/13100_content/grader/. /autograder/source/

# 7. Create a virtual display for turtle/matplotlib where needed.
Xvfb :1 &
export DISPLAY=:1

# 8. Copy student submissions into /autograder/source root.
cp -f /autograder/submission/*.xlsx /autograder/source/ 2>/dev/null || true
cp -f /autograder/submission/*.py /autograder/source/ 2>/dev/null || true

# 9. Change into source directory and run tests.
cd /autograder/source
chmod +x run_tests.py
python3 run_tests.py

# 10. Clean up virtual display.
pkill Xvfb || true